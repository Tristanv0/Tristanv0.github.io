---
import Hobbies from '../components/Hobbies.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Navbar from '../components/Navbar.astro';
import ContactModal from '../components/ContactModal.astro';
import ClosingNote from '../components/ClosingNote.astro';
import '../styles/global.css';
import '../styles/project-reveals.css';

const pageTitle = 'Tristan Cheng';
const pageDescription = 'A personal portfolio, with a little life beyond code.';
const canonicalUrl = new URL('/', Astro.site).href;
const previewImageUrl = new URL('/images/branding/social-preview.png', Astro.site).href;
const previewImageAlt = "Tristan Cheng's TC website logo.";

const projects = [
  {
    id: 'vivid',
    title: 'Vivid',
    category: 'Fitness club management',
    description: 'A team-built platform for fitness clubs to manage memberships, class bookings and finances, with real-time messaging between members and coaches.',
    technologies: ['Next.js', 'Django', 'PostgreSQL', 'Supabase', 'WebSockets'],
    logo: '/images/projects/vividfitness_logo.png',
    githubUrl: 'https://github.com/Tristanv0/vivid',
    theme: 'vivid',
  },
  {
    id: 'strevy',
    title: 'Strevy',
    category: 'Personal fitness API',
    description: 'Brings Strava runs and Hevy workouts into one API, including route images, exercise sets and training history. Powers the activity cards and calendar on this site.',
    technologies: ['Node.js', 'Express', 'Puppeteer', 'Cloudflare Workers', 'R2'],
    logo: '/images/projects/strevy_logo.png',
    githubUrl: 'https://github.com/Tristanv0/Strevy',
    theme: 'strevy',
  },
  {
    id: 'rotify',
    title: 'Rotify',
    category: 'HackHive 2025 · Team project',
    description: 'Turns text, URLs and PDFs into AI summaries with narration, captions and gameplay backgrounds. Includes a chatbot and generated quizzes to explore and test what you learn.',
    technologies: ['Next.js', 'Node.js', 'Express', 'OpenAI', 'WebSockets'],
    logo: '/images/projects/rotify_logo.png',
    githubUrl: 'https://github.com/Tristanv0/Rotify',
    theme: 'rotify',
  },
] as const;
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf8f3" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tristan Cheng" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={pageDescription} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageDescription} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={previewImageUrl} />
    <meta name="twitter:image:alt" content={previewImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=tc" />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <a class="fixed top-3.75 left-5 z-100 translate-y-[-150%] bg-ink px-4.5 py-3 text-paper focus:translate-y-0" href="#main">
      Skip to content
    </a>

    <header class="sticky top-0 z-30 border-b border-line bg-paper/95 backdrop-blur-lg">
      <div class="mx-auto flex min-h-23.75 w-[calc(100%-44px)] max-w-275 flex-wrap items-center justify-between gap-1.25 pt-4 pb-3 tablet:min-h-22 tablet:w-[calc(100%-72px)] tablet:flex-nowrap tablet:gap-6 tablet:py-0 desktop:w-[calc(100%-112px)]">
        <a class="block shrink-0 rounded-full" href="#about" aria-label="Tristan Cheng, back to About">
          <img class="size-12 tablet:size-14" src="/website_logo.svg" width="56" height="56" alt="" fetchpriority="high" />
        </a>
        <Navbar />
      </div>
    </header>

    <main id="main">
      <section class="mx-auto w-[calc(100%-44px)] max-w-[1100px] pt-10 tablet:w-[calc(100%-72px)] tablet:pt-[65px] desktop:w-[calc(100%-112px)]" id="about" aria-labelledby="about-title" data-nav-section>
        <div class="flex justify-between gap-5">
          <span class="block font-mono text-[11px] leading-[1.5] tracking-[1.65px] text-muted uppercase">A bit of backstory</span>
          <span class="hidden text-[11px] text-muted tablet:block">A personal corner of the internet</span>
        </div>
        <div class="grid grid-cols-1 items-center gap-[46px] pt-[30px] pb-[50px] tablet:grid-cols-[1fr_210px] tablet:gap-[45px] tablet:pt-[49px] tablet:pb-[66px] desktop:grid-cols-[1fr_255px] desktop:gap-20">
          <div>
            <h1 id="about-title" class="font-serif text-[clamp(43px,9.3vw,66px)] leading-[1.07] font-normal tracking-[-2px] tablet:text-[clamp(50px,5.5vw,78px)] tablet:tracking-[-3.5px]">
              Hey! I'm Tristan<br>I'm a <em class="font-normal text-rust">software developer</em>
            </h1>
            <p class="mt-3.5 max-w-[500px] text-[13px] leading-[1.85] text-muted tablet:text-[14px]">
              As a kid, I loved finding free workarounds for things you normally had to pay for. I even tried those apps promising free gems in Clash of Clans. They never worked, but I was always curious enough to try.
            </p>
            <p class="mt-3.5 max-w-[500px] text-[13px] leading-[1.85] text-muted tablet:text-[14px]">
              Nowadays, I get a thrill out of reverse engineering apps to figure out how they really work, and recreating features usually locked behind a paywall for free.
            </p>
            <p class="mt-3.5 max-w-[500px] text-[13px] leading-[1.85] text-muted tablet:text-[14px]">
              As a computer science student at TMU, I put what I learn into practice by building useful apps that bring together my interests in full-stack development, cloud computing, and automation.
            </p>
          </div>
          <aside class="relative mr-[15px] max-w-[230px] rotate-5 justify-self-end bg-[#edeedc] px-[27px] pt-[26px] pb-5 shadow-[2px_9px_15px_#41432408] tablet:mr-0 tablet:max-w-none tablet:justify-self-stretch tablet:px-[23px] tablet:pt-9 tablet:pb-[21px] desktop:px-[27px]" aria-label="A note from Tristan">
            <span class="absolute -top-2.5 left-[calc(50%-29px)] h-[22px] w-[58px] -rotate-7 bg-[#e5c999a3]" aria-hidden="true"></span>
            <span class="block font-mono text-[9px] leading-[1.5] tracking-[1px] text-[#72765c] uppercase">A note to self</span>
            <p class="mt-[19px] font-serif text-[25px] leading-[1.5] font-normal tracking-[-0.6px] tablet:text-[23px] desktop:text-[26px]">Stay curious.<br>Make useful things.<br>Go outside.</p>
            <span class="mt-3 block text-right font-serif text-[28px] leading-[1.2] text-[#7f875c] italic" aria-hidden="true">— t.</span>
          </aside>
        </div>
        <div class="flex flex-wrap justify-between gap-3 border-y border-line py-[22px] text-[10px] text-muted tablet:flex-nowrap tablet:gap-5 tablet:text-[11px]">
          <span>Software, side projects & a few miles in between.</span>
          <a class="text-ink" href="https://github.com/Tristanv0" target="_blank" rel="noreferrer">Find me on GitHub</a>
        </div>
      </section>

      <section class="mx-auto w-[calc(100%-44px)] max-w-[1100px] pt-[65px] tablet:w-[calc(100%-72px)] tablet:pt-[94px] desktop:w-[calc(100%-112px)]" id="experience" aria-labelledby="experience-title" data-nav-section>
        <SectionHeading id="experience-title" eyebrow="Along the way" title="A few stops so far" showPeriod={false}>
          Building useful tools,<br>and learning along the way
        </SectionHeading>
        <ExperienceTimeline />
      </section>

      <section class="mx-auto w-[calc(100%-44px)] max-w-[1100px] pt-[65px] tablet:w-[calc(100%-72px)] tablet:pt-[94px] desktop:w-[calc(100%-112px)]" id="projects" aria-labelledby="projects-title" data-nav-section>
        <SectionHeading id="projects-title" eyebrow="Things I've made" title="Ideas, made tangible" showPeriod={false} showCaptionOnMobile>
          <a class="text-rust underline decoration-rust/35 underline-offset-4 transition-colors hover:decoration-rust" href="https://github.com/Tristanv0" target="_blank" rel="noopener noreferrer">check out my other projects!</a>
        </SectionHeading>
        <div class="grid grid-cols-1 gap-[35px] tablet:grid-cols-3 tablet:gap-5 desktop:gap-[25px]">
          {projects.map(project => <ProjectCard {...project} />)}
        </div>
        <div class="mt-9 flex items-center justify-between border-t border-line py-[27px] font-serif text-[15px] leading-[1.5] text-muted italic tablet:mt-[45px] tablet:py-[38px] tablet:text-[17px]">
          <span>And when I close the laptop…</span>
          <span class="font-sans text-[24px] leading-none text-rust not-italic" aria-hidden="true">↓</span>
        </div>
      </section>

      <Hobbies />
      <ClosingNote />
    </main>

    <footer class="mx-auto flex min-h-23.75 w-[calc(100%-44px)] max-w-[1100px] items-center justify-between gap-3 border-t border-transparent pt-4 pb-3 tablet:min-h-[89px] tablet:w-[calc(100%-72px)] tablet:gap-[25px] tablet:py-0 desktop:w-[calc(100%-112px)]">
      <a class="block shrink-0 rounded-full" href="#about" aria-label="Tristan Cheng, back to About">
        <img class="size-12 tablet:size-14" src="/website_logo.svg" width="56" height="56" alt="" />
      </a>
      <p class="whitespace-nowrap text-[10px] text-muted tablet:text-[11px]">© 2026 Tristan Cheng</p>
      <a class="shrink-0 whitespace-nowrap text-[10px] text-muted tablet:text-[11px]" href="#about">Back to the top <span class="ml-[9px] text-rust" aria-hidden="true">↑</span></a>
    </footer>
    <ContactModal />
    <script>
      import { initPageScroll } from '../scripts/page-scroll';
      import { initProjectReveals } from '../scripts/project-reveals';
      initPageScroll();
      initProjectReveals();
    </script>
  </body>
</html>
