---
import Hobbies from '../components/Hobbies.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import '../styles/global.css';

const pageTitle = 'Tristan Cheng';
const pageDescription = 'A personal portfolio, with a little life beyond the code.';
const canonicalUrl = new URL('/', Astro.site).href;
const previewImageUrl = new URL('/images/branding/social-preview.png', Astro.site).href;
const previewImageAlt = "Tristan Cheng's TC website logo.";

const projects = [
  {
    id: 'vivid',
    title: 'Vivid',
    category: 'Fitness club management',
    description: 'A team-built platform for fitness clubs to manage memberships, class bookings and finances, with real-time messaging between members and coaches.',
    technologies: ['Next.js', 'Django', 'PostgreSQL', 'Supabase', 'WebSockets'],
    logo: '/images/projects/vividfitness_logo.png',
    githubUrl: 'https://github.com/Tristanv0/vivid',
    theme: 'vivid',
  },
  {
    id: 'strevy',
    title: 'Strevy',
    category: 'Personal fitness API',
    description: 'Brings Strava runs and Hevy workouts into one API, including route images, exercise sets and training history. Powers the activity cards and calendar on this site.',
    technologies: ['Node.js', 'Express', 'Puppeteer', 'Cloudflare Workers', 'R2'],
    logo: '/images/projects/strevy_logo.png',
    githubUrl: 'https://github.com/Tristanv0/Strevy',
    theme: 'strevy',
  },
  {
    id: 'rotify',
    title: 'Rotify',
    category: 'HackHive 2025 · Team project',
    description: 'Turns text, URLs and PDFs into AI summaries with narration, captions and gameplay backgrounds. Includes a chatbot and generated quizzes to explore and test what you learn.',
    technologies: ['Next.js', 'Node.js', 'Express', 'OpenAI', 'WebSockets'],
    logo: '/images/projects/rotify_logo.png',
    githubUrl: 'https://github.com/Tristanv0/Rotify',
    theme: 'rotify',
  },
] as const;

const experiences = [
  {
    date: 'Jan 2025 — Dec 2025',
    title: 'Full Stack Developer Intern',
    company: 'Workplace Safety & Insurance Board (WSIB) — Innovation Lab',
    logo: '/images/companies/wsib-logo.jpeg',
    location: 'Waterloo, ON',
    highlights: [
      'Built a React and Flask dashboard with search and verification, cutting accommodation-entry time by **over 50%**.',
      'Automated record extraction from **320 PDF and DOCX documents** with PyMuPDF, docx2txt and Azure OpenAI. Ranked related accommodation records using embeddings, cosine similarity and weighted Jaccard similarity.',
      'Secured APIs with JWT authentication, role-based access control, Redis rate limiting and email verification. Deployed the application on Azure and authored **172 pytest integration tests** across **10 backend modules**.',
    ],
  },
  {
    date: 'Jan 2024 — Dec 2024',
    title: 'Student Software Developer',
    company: 'TMU Chinese Student Association',
    logo: '/images/companies/tmu-csa-logo.png',
    location: 'Toronto, ON',
    highlights: [
      'Built a responsive Next.js application with dynamic event galleries and social media integration to showcase club activities and engage members.',
      'Created and assigned development tickets, tracked milestones and coordinated deliverables with the project roadmap and deadlines.',
      'Delivered the student association website, which has reached **250+ unique visitors**.',
    ],
  },
  {
    date: 'Aug 2024 — Dec 2024',
    title: 'Quality Assurance Lead Intern',
    company: 'Unity Health Toronto',
    logo: '/images/companies/unity-health-toronto-logo.jpeg',
    location: 'Toronto, ON',
    highlights: [
      'Coordinated black-box testing with a **99% success rate** across test cases.',
      'Led **6 student testers**, organizing workloads and test plans to reduce duplicate work and improve testing efficiency.',
    ],
  },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-32.5 tablet:scroll-pt-25 motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf8f3" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tristan Cheng" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={pageDescription} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageDescription} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={previewImageUrl} />
    <meta name="twitter:image:alt" content={previewImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=tc" />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <a class="fixed top-3.75 left-5 z-100 translate-y-[-150%] bg-ink px-4.5 py-3 text-paper focus:translate-y-0" href="#main">
      Skip to content
    </a>

    <header class="sticky top-0 z-30 border-b border-line bg-paper/95 backdrop-blur-lg">
      <div class="mx-auto flex min-h-23.75 w-[calc(100%-44px)] max-w-275 flex-wrap items-center justify-between gap-1.25 pt-4 pb-3 tablet:min-h-22 tablet:w-[calc(100%-72px)] tablet:flex-nowrap tablet:gap-6 tablet:py-0 desktop:w-[calc(100%-112px)]">
        <a class="block shrink-0 rounded-full" href="#about" aria-label="Tristan Cheng, back to About">
          <img class="size-12 tablet:size-14" src="/website_logo.svg" width="56" height="56" alt="" fetchpriority="high" />
        </a>
        <nav class="flex w-full gap-4.75 text-[11px] phone:gap-6 tablet:w-auto tablet:gap-7.5 tablet:text-[13px]" aria-label="Main navigation">
          <a class="py-1 text-[#68685e] transition-colors duration-150 hover:text-rust tablet:py-2.5" href="#about">About</a>
          <a class="py-1 text-[#68685e] transition-colors duration-150 hover:text-rust tablet:py-2.5" href="#experience">Experience</a>
          <a class="py-1 text-[#68685e] transition-colors duration-150 hover:text-rust tablet:py-2.5" href="#projects">Projects</a>
          <a class="py-1 text-rust tablet:py-2.5" href="#hobbies">Hobbies</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="mx-auto w-[calc(100%-44px)] max-w-[1100px] scroll-mt-[30px] pt-10 tablet:w-[calc(100%-72px)] tablet:pt-[65px] desktop:w-[calc(100%-112px)]" id="about" aria-labelledby="about-title">
        <div class="flex justify-between gap-5">
          <span class="block font-mono text-[11px] leading-[1.5] tracking-[1.65px] text-muted uppercase">A little about me</span>
          <span class="hidden text-[11px] text-muted tablet:block">A personal corner of the internet</span>
        </div>
        <div class="grid grid-cols-1 items-center gap-[46px] pt-[30px] pb-[50px] tablet:grid-cols-[1fr_210px] tablet:gap-[45px] tablet:pt-[49px] tablet:pb-[66px] desktop:grid-cols-[1fr_255px] desktop:gap-20">
          <div>
            <h1 id="about-title" class="font-serif text-[clamp(43px,9.3vw,66px)] leading-[1.07] font-normal tracking-[-2px] tablet:text-[clamp(50px,5.5vw,78px)] tablet:tracking-[-3.5px]">
              A curious mind.<br>A work <em class="font-normal text-rust">in progress.</em>
            </h1>
            <p class="mt-[29px] text-[14px] tracking-[-0.2px] tablet:text-[16px]">Hey, I'm Tristan. Welcome to my little space.</p>
            <p class="mt-3.5 max-w-[465px] text-[13px] leading-[1.85] text-muted tablet:text-[14px]">
              A short introduction will live here. A bit about who I am, what I'm learning, and the kinds of things I like to build. For now, I'm getting the foundations in place.
            </p>
            <a class="mt-[25px] inline-flex items-center gap-[26px] text-[13px] text-rust underline-offset-[5px] hover:underline" href="#projects">
              Take a look around
            </a>
          </div>
          <aside class="relative mr-[15px] max-w-[230px] rotate-5 justify-self-end bg-[#edeedc] px-[27px] pt-[26px] pb-5 shadow-[2px_9px_15px_#41432408] tablet:mr-0 tablet:max-w-none tablet:justify-self-stretch tablet:px-[23px] tablet:pt-9 tablet:pb-[21px] desktop:px-[27px]" aria-label="A note from Tristan">
            <span class="absolute -top-2.5 left-[calc(50%-29px)] h-[22px] w-[58px] -rotate-7 bg-[#e5c999a3]" aria-hidden="true"></span>
            <span class="block font-mono text-[9px] leading-[1.5] tracking-[1px] text-[#72765c] uppercase">A note to self</span>
            <p class="mt-[19px] font-serif text-[25px] leading-[1.5] font-normal tracking-[-0.6px] tablet:text-[23px] desktop:text-[26px]">Stay curious.<br>Make useful things.<br>Go outside.</p>
            <span class="mt-3 block text-right font-serif text-[28px] leading-[1.2] text-[#7f875c] italic" aria-hidden="true">— t.</span>
          </aside>
        </div>
        <div class="flex flex-wrap justify-between gap-3 border-y border-line py-[22px] text-[10px] text-muted tablet:flex-nowrap tablet:gap-5 tablet:text-[11px]">
          <span>Software, side projects & a few miles in between.</span>
          <a class="text-ink" href="https://github.com/Tristanv0" target="_blank" rel="noreferrer">Find me on GitHub</a>
        </div>
      </section>

      <section class="mx-auto w-[calc(100%-44px)] max-w-[1100px] scroll-mt-[30px] pt-[65px] tablet:w-[calc(100%-72px)] tablet:pt-[94px] desktop:w-[calc(100%-112px)]" id="experience" aria-labelledby="experience-title">
        <SectionHeading id="experience-title" eyebrow="Along the way" title="A few stops so far" showPeriod={false}>
          Building useful tools,<br>and learning along the way
        </SectionHeading>
        <div class="border-t border-line">
          {experiences.map(experience => <ExperienceEntry experience={experience} />)}
        </div>
      </section>

      <section class="mx-auto w-[calc(100%-44px)] max-w-[1100px] scroll-mt-[30px] pt-[65px] tablet:w-[calc(100%-72px)] tablet:pt-[94px] desktop:w-[calc(100%-112px)]" id="projects" aria-labelledby="projects-title">
        <SectionHeading id="projects-title" eyebrow="Things I've made" title="Ideas, made tangible" showCaptionOnMobile>
          <a class="text-rust underline decoration-rust/35 underline-offset-4 transition-colors hover:decoration-rust" href="https://github.com/Tristanv0" target="_blank" rel="noopener noreferrer">check out my other projects!</a>
        </SectionHeading>
        <div class="grid grid-cols-1 gap-[35px] tablet:grid-cols-3 tablet:gap-5 desktop:gap-[25px]">
          {projects.map(project => <ProjectCard {...project} />)}
        </div>
        <div class="mt-9 flex items-center justify-between border-t border-line py-[27px] font-serif text-[15px] leading-[1.5] text-muted italic tablet:mt-[45px] tablet:py-[38px] tablet:text-[17px]">
          <span>And when I close the laptop…</span>
          <span class="font-sans text-[24px] leading-none text-rust not-italic" aria-hidden="true">↓</span>
        </div>
      </section>

      <Hobbies />
    </main>

    <footer class="mx-auto flex w-[calc(100%-44px)] max-w-[1100px] flex-wrap items-center justify-between gap-[17px] py-7 tablet:w-[calc(100%-72px)] tablet:flex-nowrap tablet:gap-[25px] tablet:py-[34px] desktop:w-[calc(100%-112px)]">
      <a class="text-[16px] font-semibold tracking-[-1px] whitespace-nowrap" href="#about">tristan cheng<span class="text-rust">.</span></a>
      <p class="order-3 w-full text-[10px] text-muted tablet:order-none tablet:w-auto tablet:text-[11px]">Always a work in progress.</p>
      <a class="ml-auto text-[10px] text-muted tablet:ml-0 tablet:text-[11px]" href="#about">Back to the top <span class="ml-[9px] text-rust" aria-hidden="true">↑</span></a>
    </footer>
    <script>
      import { initPageScroll } from '../scripts/page-scroll';
      initPageScroll();
    </script>
  </body>
</html>
