---
import PrivateLayout from '../layouts/PrivateLayout.astro';
---
<PrivateLayout title="Sign in">
  <span class="mb-3 font-mono text-[10px] tracking-[1.5px] text-muted uppercase">Personal space</span>
  <h1 class="font-handwritten text-[52px] leading-[1.05] tablet:text-[64px]">A space of my own.</h1>
  <p class="mt-5 max-w-[360px] text-sm leading-[1.85] text-muted">A few personal tools and ideas, tucked away from the portfolio.</p>
  <div class="mt-9 rounded-2xl border border-line bg-white/40 p-6 tablet:p-8">
    <h2 class="text-base font-medium">Welcome back, Tristan.</h2>
    <p class="mt-2 text-[13px] leading-[1.8] text-muted">Sign in with a one-time code sent to your approved email address.</p>
    <a class="mt-6 flex w-full items-center justify-center gap-3 rounded-full bg-ink px-5 py-3.5 text-sm text-paper transition-colors hover:bg-[#41423b]" href="/private/" data-private-sign-in>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></svg>
      Continue with email
    </a>
    <p class="mt-4 text-center text-[10px] leading-[1.7] text-muted">Secure sign-in with Cloudflare Access. No password needed.</p>
  </div>
</PrivateLayout>
