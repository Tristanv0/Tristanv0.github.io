---
import type { Run } from '../data/runs';
import Odometer from './Odometer.astro';

interface Props {
  run: Run;
  index: number;
}

const { run, index } = Astro.props;
// Keep complete class names here so Tailwind can discover every variant.
const variants = [
  { tilt: '-rotate-3', paper: 'bg-[#f2eee4]', aspect: 'aspect-[4/3]' },
  { tilt: 'rotate-[2.5deg]', paper: 'bg-[#edf0e4]', aspect: 'aspect-square' },
  { tilt: '-rotate-[1.5deg]', paper: 'bg-[#f5eadd]', aspect: 'aspect-[5/4]' },
  { tilt: 'rotate-[3.5deg]', paper: 'bg-[#f2eee4]', aspect: 'aspect-[4/5]' },
  { tilt: '-rotate-2', paper: 'bg-[#edf0e4]', aspect: 'aspect-[3/2]' },
];
const variant = variants[index % variants.length];
---

<button
  class:list={[
    'group relative block w-full min-w-0 rounded-[3px] border border-[#ded9cb] bg-run-paper p-2 text-left text-ink shadow-[0_5px_14px_#342c1d07] transition duration-[220ms] ease-[ease] hover:-translate-y-[7px] hover:rotate-0 hover:shadow-[0_10px_28px_#342c1d0c] desktop:p-2.5',
    variant.tilt,
  ]}
  type="button"
  data-run-card
  data-run-modal={`run-modal-${run.id}`}
  data-activity-card
  data-activity-modal={`run-modal-${run.id}`}
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls={`run-modal-${run.id}`}
  aria-label={`View ${run.title} details`}
>
  <div class:list={['relative px-2.5 pt-2.5 pb-3', variant.paper]}>
    <div
      class:list={['group/media relative isolate flex w-full items-center justify-center overflow-hidden', variant.aspect]}
      data-run-media
      data-has-photo={Boolean(run.photoUrl)}
    >
      {run.photoUrl && (
        <img
          class="absolute inset-0 z-0 h-full w-full object-cover"
          src={run.photoUrl}
          alt={`Photo from ${run.title}`}
          loading="lazy"
          decoding="async"
          data-run-photo
        />
      )}
      <span class="pointer-events-none absolute inset-0 z-10 bg-black/20" hidden={!run.photoUrl} aria-hidden="true" data-photo-shade></span>
      {run.routeImage && (
        <img
          class="absolute inset-0 z-20 h-full w-full object-contain p-3 group-data-[has-photo=true]/media:drop-shadow-[0_0_2px_rgba(255,255,255,0.95)]"
          src={run.routeImage.src}
          width={run.routeImage.width}
          height={run.routeImage.height}
          alt={`Route for ${run.title}`}
          loading="lazy"
          decoding="async"
          data-run-route
        />
      )}
      <span class="relative z-20 text-[12px] text-muted" hidden={Boolean(run.routeImage || run.photoUrl)} data-media-unavailable>Image unavailable</span>
    </div>
    <span class="block text-center font-serif text-[15px] leading-[1.3] text-[#726a58] italic">{run.day}</span>
  </div>
  <div class="px-2 pt-4 pb-3">
    <time class="font-mono text-[9px] leading-[1.5] text-muted" datetime={run.dateTime ?? undefined}>{run.dateLabel}</time>
    <h4 class="mt-2 mb-4 font-serif text-[21px] leading-[1.25] font-normal tracking-[-0.5px] break-words">{run.title}</h4>
    <div class="flex justify-between gap-2">
      <span class="grid gap-[7px]">
        <strong class="text-[13px] font-normal whitespace-nowrap tabular-nums"><Odometer value={run.distance} /><small class="text-[9px] text-muted"> km</small></strong>
        <span class="font-mono text-[8px] leading-[1.5] text-muted">Distance</span>
      </span>
      <span class="grid gap-[7px]">
        <strong class="text-[13px] font-normal whitespace-nowrap tabular-nums"><Odometer value={run.time} /></strong>
        <span class="font-mono text-[8px] leading-[1.5] text-muted">Moving time</span>
      </span>
      <span class="grid gap-[7px]">
        <strong class="text-[13px] font-normal whitespace-nowrap tabular-nums"><Odometer value={run.pace} /></strong>
        <span class="font-mono text-[8px] leading-[1.5] text-muted">Pace / km</span>
      </span>
    </div>
  </div>
</button>

<script>
  document.querySelectorAll<HTMLElement>('[data-run-media]').forEach(frame => {
    const photo = frame.querySelector<HTMLImageElement>('[data-run-photo]');
    const route = frame.querySelector<HTMLImageElement>('[data-run-route]');
    const shade = frame.querySelector<HTMLElement>('[data-photo-shade]');
    const fallback = frame.querySelector<HTMLElement>('[data-media-unavailable]');

    function updateLayers() {
      const hasPhoto = Boolean(photo && !photo.hidden);
      const hasRoute = Boolean(route && !route.hidden);
      frame.dataset.hasPhoto = String(hasPhoto);
      if (shade) shade.hidden = !hasPhoto;
      if (fallback) fallback.hidden = hasPhoto || hasRoute;
    }

    [photo, route].forEach(image => {
      if (!image) return;
      image.addEventListener('error', () => {
        image.hidden = true;
        updateLayers();
      });
      if (image.complete && image.naturalWidth === 0) image.hidden = true;
    });
    updateLayers();
  });
</script>
