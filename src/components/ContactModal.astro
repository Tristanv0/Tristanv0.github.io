---
import { CONTACT_ACCEPT } from '../data/contact';
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---

<dialog id="contact-modal" class="contact-dialog" aria-labelledby="contact-title" data-contact-dialog data-contact-endpoint={endpoint}>
  <article class="contact-stage" tabindex="-1" data-contact-stage>
    <div class="contact-controls"><button type="button" class="contact-close" aria-label="Close contact form" data-contact-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button></div>
    <section class="contact-compose" data-contact-compose>
      <span class="contact-eyebrow">A little hello goes a long way</span>
      <h2 id="contact-title">Let’s connect!</h2>
      <p class="contact-intro">Have an idea, a question, or just want to say hi?</p>
      <p class="contact-draft-note" role="status" hidden data-contact-draft-note>Your draft is back. It’s saved here until you refresh.</p>
      <form data-contact-form>
        <div class="contact-field-pair">
          <label>Your name<input name="name" autocomplete="name" required maxlength="80" placeholder="What should I call you?" data-contact-name /></label>
          <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></label>
        </div>
        <label>Subject <span class="contact-optional">(optional)</span><input name="subject" maxlength="160" placeholder="What’s on your mind?" /></label>
        <label>Your message<textarea name="message" required maxlength="5000" rows="5" placeholder="Tell me a little about it…"></textarea></label>
        <div class="contact-honeypot" aria-hidden="true" inert><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="contact-attachments">
          <input id="contact-attachments" class="contact-file-input" type="file" multiple accept={CONTACT_ACCEPT} tabindex="-1" aria-label="Choose attachments" data-contact-file-input />
          <button class="contact-attach-button" type="button" data-contact-attach>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 13 7-7a3 3 0 0 1 4 4l-9 9a5 5 0 0 1-7-7l9-9m-7 12 9-9" /></svg>
            Attach files <span class="contact-optional">(optional)</span>
          </button>
          <span class="contact-file-hint">Documents or images · up to 3 files, 5 MB total</span>
          <ul class="contact-files" aria-label="Attached files" data-contact-files></ul>
          <p class="contact-error" role="alert" hidden data-contact-file-error></p>
        </div>
        <p class="contact-error" role="alert" hidden data-contact-error></p>
        <div class="contact-form-footer">
          <button type="submit" class="contact-primary" data-contact-send>Send message</button>
        </div>
      </form>
    </section>
    <section class="contact-success" hidden aria-labelledby="contact-success-title" data-contact-success>
      <svg class="flying-envelope" viewBox="0 0 200 120" fill="none" aria-hidden="true" focusable="false">
        <g class="envelope-flight">
          <g class="envelope-wing wing-left" fill="#efdfd0" stroke="#c18e6c" stroke-width="1.6" stroke-linejoin="round">
            <path d="M69 62C55 43 44 27 16 23c4 12 11 20 23 26-12-5-18-4-23-3 7 12 17 18 31 19-10 0-16 3-18 5 13 10 29 8 40 0Z" />
          </g>
          <g class="envelope-wing wing-right" fill="#efdfd0" stroke="#c18e6c" stroke-width="1.6" stroke-linejoin="round">
            <path d="M131 62c14-19 25-35 53-39-4 12-11 20-23 26 12-5 18-4 23-3-7 12-17 18-31 19 10 0 16 3 18 5-13 10-29 8-40 0Z" />
          </g>
          <rect x="62" y="42" width="76" height="52" rx="7" fill="#faf8f3" stroke="#c05228" stroke-width="1.8" />
          <path d="m64 46 36 26 36-26m-72 44 24-22m48 22-24-22" stroke="#c05228" stroke-width="1.6" stroke-linejoin="round" />
          <path d="m94 80 4 4 8-9" stroke="#8a9b71" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </svg>
      <span class="contact-eyebrow">On its way</span>
      <h2 id="contact-success-title" tabindex="-1">Email sent!</h2>
      <p>Thanks for reaching out. I'll do my best<br class="contact-wide-break" /> to respond within 24 hours!</p>
      <button class="contact-secondary" type="button" data-contact-done>Back to exploring</button>
    </section>
  </article>
</dialog>

<dialog class="contact-dialog contact-confirm-dialog" aria-labelledby="contact-confirm-title" aria-describedby="contact-confirm-description" data-contact-confirm>
  <article class="contact-confirm-panel">
    <span class="contact-eyebrow">Before you go</span>
    <h2 id="contact-confirm-title">Keep this for later?</h2>
    <p id="contact-confirm-description">You’ve started a message. Save it for this visit, discard it, or keep writing.</p>
    <p class="contact-save-hint">Saved text and attachments stay here until the page is refreshed.</p>
    <div class="contact-confirm-actions">
      <button type="button" class="contact-primary" data-contact-save>Save for now</button>
      <button type="button" class="contact-secondary" autofocus data-contact-continue>Keep writing</button>
      <button type="button" class="contact-discard" data-contact-discard>Discard message</button>
    </div>
  </article>
</dialog>

<script>
  import { initContactModal } from '../scripts/contact-modal';
  initContactModal();
</script>

<style>
  [hidden] { display: none !important; }
  .contact-dialog { position: fixed; inset: 0; margin: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; padding: 20px; border: 0; overflow: hidden; background: transparent; color: var(--color-ink); }
  .contact-dialog[open] { display: flex; align-items: center; justify-content: center; }
  .contact-dialog::backdrop { background: #292a2570; backdrop-filter: blur(6px); }
  .contact-stage { position: relative; width: 100%; max-width: 620px; max-height: calc(100dvh - 40px); overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--color-line); border-radius: 24px; background: var(--color-paper); box-shadow: 0 24px 100px #292a2533; }
  .contact-stage:focus { outline: none; }
  .contact-controls { position: sticky; top: 0; z-index: 2; height: 0; }
  .contact-close { position: absolute; top: 18px; right: 18px; z-index: 2; display: grid; place-items: center; width: 34px; height: 34px; padding: 0; border: 1px solid var(--color-line); border-radius: 50%; background: var(--color-paper); color: var(--color-ink); transition: background-color 180ms ease; }
  .contact-close:hover { background: var(--color-hobby-paper); }
  .contact-close svg { width: 18px; height: 18px; }
  .contact-compose { padding: 30px 24px 24px; }
  .contact-eyebrow { display: block; padding-right: 34px; color: var(--color-rust); font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.1px; line-height: 1.6; text-transform: uppercase; }
  h2 { margin: 12px 0; font-family: var(--font-serif); font-size: 34px; font-weight: 400; line-height: 1.15; letter-spacing: -1px; }
  .contact-intro { margin-bottom: 24px; color: var(--color-muted); font-size: 13px; line-height: 1.7; }
  form { display: grid; gap: 16px; }
  label { display: block; color: var(--color-ink); font-size: 11px; line-height: 1.5; }
  input:not([type='file']), textarea { display: block; width: 100%; min-height: 44px; margin-top: 7px; padding: 11px 12px; border: 1px solid var(--color-line); border-radius: 9px; background: #fffefa; color: var(--color-ink); font-family: var(--font-sans); font-size: 16px; line-height: 1.5; transition: border-color 180ms ease, box-shadow 180ms ease; }
  input:focus, textarea:focus { border-color: var(--color-rust); outline: none; box-shadow: 0 0 0 3px #c0522810; }
  input::placeholder, textarea::placeholder { color: #99958b; }
  textarea { min-height: 116px; max-height: 260px; resize: vertical; }
  .contact-optional { color: var(--color-muted); font-weight: 400; }
  .contact-field-pair { display: grid; gap: 16px; }
  .contact-honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .contact-draft-note { margin: -8px 0 20px; padding: 9px 12px; border-radius: 8px; background: #e9eddf; color: #61704f; font-size: 11px; line-height: 1.6; }
  .contact-attach-button { display: inline-flex; align-items: center; gap: 7px; min-height: 34px; font-size: 11px; color: var(--color-ink); }
  .contact-attach-button svg { width: 17px; height: 17px; color: var(--color-rust); }
  .contact-file-input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .contact-file-hint { display: block; margin-top: 1px; font-size: 9px; line-height: 1.6; color: var(--color-muted); }
  .contact-files { display: grid; gap: 6px; }
  :global([data-contact-files] .contact-file-row) { display: flex; align-items: center; gap: 10px; margin-top: 6px; padding: 8px 10px; border: 1px solid var(--color-line); border-radius: 8px; background: #f2eee5; font-size: 10px; }
  :global([data-contact-files] .contact-file-name) { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global([data-contact-files] .contact-file-size) { color: var(--color-muted); white-space: nowrap; }
  :global([data-contact-files] button) { display: grid; place-items: center; flex: 0 0 28px; width: 28px; height: 28px; padding: 0; line-height: 1; color: var(--color-muted); }
  :global([data-contact-files] button svg) { display: block; width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
  .contact-error { margin: 5px 0 0; color: #a0392e; font-size: 11px; line-height: 1.6; }
  .contact-form-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 14px; padding-top: 16px; border-top: 1px solid var(--color-line); }
  .contact-primary, .contact-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 44px; padding: 11px 18px; border: 1px solid transparent; border-radius: 999px; font-size: 12px; line-height: 1.4; transition: background-color 180ms ease, opacity 180ms ease; }
  .contact-primary { background: var(--color-rust); color: white; }
  .contact-primary:hover { background: #a84523; }
  .contact-secondary { border-color: var(--color-line); color: var(--color-ink); background: var(--color-paper); }
  .contact-secondary:hover { background: var(--color-hobby-paper); }
  button:disabled { cursor: wait; opacity: .6; }
  .contact-success { padding: 38px 24px 30px; text-align: center; }
  .contact-success .contact-eyebrow { padding: 0; }
  .contact-success h2 { margin-top: 10px; }
  .contact-success p { color: var(--color-muted); font-size: 13px; line-height: 1.8; }
  .contact-success .contact-secondary { margin-top: 24px; }
  .flying-envelope { display: block; width: 190px; height: 114px; margin: 0 auto 8px; }
  .contact-success:not([hidden]) .envelope-flight { animation: envelope-float 2400ms ease-in-out infinite; transform-origin: 100px 60px; }
  .contact-success:not([hidden]) .envelope-wing { animation: envelope-flap 700ms ease-in-out infinite alternate; transform-box: fill-box; }
  .wing-left { transform-origin: right center; }
  .wing-right { transform-origin: left center; animation-direction: alternate-reverse !important; }
  @keyframes envelope-float { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-7px) rotate(2deg); } }
  @keyframes envelope-flap { from { rotate: -12deg; } to { rotate: 12deg; } }
  .contact-confirm-dialog::backdrop { background: #292a2559; backdrop-filter: blur(3px); }
  .contact-confirm-panel { width: 100%; max-width: 430px; max-height: calc(100dvh - 40px); overflow-y: auto; padding: 30px 26px 22px; border: 1px solid var(--color-line); border-radius: 22px; background: var(--color-paper); box-shadow: 0 24px 100px #292a2533; }
  .contact-confirm-panel h2 { font-size: 29px; }
  .contact-confirm-panel p { color: var(--color-muted); font-size: 12px; line-height: 1.8; }
  .contact-confirm-panel .contact-save-hint { margin-top: 12px; font-size: 10px; }
  .contact-confirm-actions { display: grid; gap: 10px; margin-top: 24px; }
  .contact-discard { min-height: 40px; color: #9b4a38; font-size: 11px; }
  @media (width >= 501px) { .contact-field-pair { grid-template-columns: 1fr 1fr; } }
  @media (width >= 701px) {
    .contact-compose { padding: 34px; }
    h2 { font-size: 39px; }
    input:not([type='file']), textarea { font-size: 13px; }
    .contact-close { top: 22px; right: 22px; }
  }
  @media (height < 740px) { .contact-dialog { padding: 12px; } .contact-stage, .contact-confirm-panel { max-height: calc(100dvh - 24px); } }
  @media (prefers-reduced-motion: reduce) { .contact-success:not([hidden]) .envelope-flight, .contact-success:not([hidden]) .envelope-wing { animation: none; } }
</style>
