---
interface Props {
  number: string;
  title: string;
  category: string;
  style: 'circles' | 'windows' | 'lines';
}

const { number, title, category, style } = Astro.props;
const backgrounds = {
  circles: 'bg-[#e9ebdd]',
  windows: 'bg-[#f2e8dc]',
  lines: 'bg-[#e4e8e9]',
};
const circlePositions = ['-translate-x-[34px]', 'translate-x-[34px]', 'translate-y-[34px]'];
const windowPositions = [
  '-translate-x-[25px] -translate-y-5 -rotate-8',
  'rotate-2',
  'translate-x-[25px] translate-y-5 rotate-11',
];
---

<article>
  <div class:list={['relative grid h-[215px] place-items-center overflow-hidden tablet:h-[190px]', backgrounds[style]]} aria-hidden="true">
    {style === 'circles' && circlePositions.map(position => (
      <span class:list={['absolute size-[115px] rounded-full border border-[#9ca67b]', position]}></span>
    ))}
    {style === 'windows' && windowPositions.map(position => (
      <span class:list={['absolute h-[84px] w-[120px] rounded-[3px] border border-[#be9d7f] bg-[#f4ecdf]', position]}></span>
    ))}
    {style === 'lines' && ['h-[90px]', 'h-[60px]', 'h-[30px]'].map(height => (
      <span class:list={['absolute w-[170px] -rotate-30 rounded-[50%] border border-[#899ca0]', height]}></span>
    ))}
    <span class="absolute bottom-3.5 left-[15px] font-mono text-[10px] leading-none text-[#686c58]">{number}</span>
  </div>
  <div class="pt-[17px] tablet:pt-[22px]">
    <span class="block font-mono text-[9px] leading-[1.5] tracking-[1px] text-muted uppercase">{category}</span>
    <h3 class="mt-[9px] text-[18px] font-medium tracking-[-0.6px]">{title}</h3>
    <p class="mt-2.5 text-xs leading-[1.8] text-muted tablet:max-w-[270px]">A place for a project, the problem it solves, and a little of the story behind it.</p>
    <span class="mt-3 inline-block font-mono text-[10px] leading-[1.5] text-muted tablet:mt-[18px]">Project placeholder</span>
  </div>
</article>
