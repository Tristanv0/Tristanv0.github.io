---
import { buildActivityCalendar, activityColor, circlePose, preferredActivity, type CalendarActivity } from '../data/activity-calendar';
import { CALENDAR_DAY_CLASS, CALENDAR_TITLE_CLASS, CALENDAR_TITLE_FADE, WEEKDAYS, WORKOUT_TIME_ZONE } from '../data/workout-calendar';
interface Props { activities: CalendarActivity[] }
const { activities } = Astro.props;
const calendar = buildActivityCalendar(new Date(), activities);
---

<aside class="relative mx-auto mb-6 w-[calc(100%-2*var(--run-edge,22px))] max-w-[360px] bg-hobby-paper shadow-[0_0_24px_14px_var(--color-hobby-paper)] tablet:absolute tablet:top-[var(--calendar-baseline,44px)] tablet:right-[var(--run-edge,36px)] tablet:mb-0 tablet:w-[280px] tablet:max-w-none tablet:-translate-y-full desktop:w-[360px] wide:w-[380px]" aria-labelledby="activity-calendar-month" data-activity-calendar data-run-leading data-calendar-activities={JSON.stringify(activities)} data-time-zone={WORKOUT_TIME_ZONE}>
  <h3 id="activity-calendar-month" class="mb-3 text-center text-[15px] font-medium tracking-[-0.3px] text-ink tablet:text-[18px]" data-calendar-month>{calendar.monthLabel}</h3>
  <table class="w-full table-fixed border-separate border-spacing-y-1 text-center" aria-label={`${calendar.monthLabel} hobby activities`} data-calendar-table>
    <thead><tr>{WEEKDAYS.map(day => <th scope="col" class="border-b border-line pb-2 text-[10px] font-normal text-muted tablet:text-[11px]"><abbr title={day} class="no-underline">{day[0]}</abbr></th>)}</tr></thead>
    <tbody data-calendar-days>
      {calendar.weeks.map(week => <tr>{week.map(day => {
        const entries = day?.activities ?? [];
        const front = preferredActivity(entries, 'running');
        const title = entries[front]?.title ?? '';
        return <td class="h-11 p-0 align-top tablet:h-12" aria-hidden={!day ? 'true' : undefined} tabindex={entries.length ? 0 : undefined} data-calendar-entry={entries.length ? '' : undefined} data-calendar-items={entries.length ? JSON.stringify(entries) : undefined}>
          {day && <span class:list={[CALENDAR_DAY_CLASS, entries.length || day.today ? 'text-white' : 'text-ink']} data-calendar-day={day.date} data-calendar-today-dot={day.today ? '' : undefined}>
            {entries.map((entry, index) => {
              const pose = circlePose(index, front, entries.length);
              return <span class="absolute inset-0 rounded-full border" style={`background-color:${activityColor(entry.hobby)};transform:${pose.transform};z-index:${pose.zIndex};border-color:${pose.borderColor}`} data-calendar-circle={index} data-calendar-hobby={entry.hobby} aria-hidden="true"></span>;
            })}
            {day.today && !entries.length && <span class="absolute inset-0 rounded-full bg-[var(--hobby-color)] transition-colors duration-200" aria-hidden="true"></span>}
            <time class="pointer-events-none relative z-[100]" datetime={day.date} aria-label={day.label} aria-current={day.today ? 'date' : undefined}>{day.day}</time>
          </span>}
          {entries.length > 0 && <span class={CALENDAR_TITLE_CLASS} style={Array.from(title).length > 10 ? CALENDAR_TITLE_FADE : undefined} aria-hidden="true" data-calendar-workout-title><span class="shrink-0">{title}</span></span>}
        </td>;
      })}</tr>)}
    </tbody>
  </table>
  <p class="sr-only" data-calendar-note>Orange marks running, blue marks gym workouts, and green marks badminton. Stacked circles mark multiple activities. Hover or focus a day to see every activity.</p>
</aside>

<style>
  :global([data-activity-calendar] [data-calendar-entry]:focus-visible) { outline: 1px solid var(--hobby-color); outline-offset: 2px; border-radius: 6px; }
</style>

<script>
  import { initActivityCalendars } from '../scripts/activity-calendar';
  initActivityCalendars();
</script>
