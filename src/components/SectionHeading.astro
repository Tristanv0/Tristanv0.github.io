---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  showPeriod?: boolean;
  showCaptionOnMobile?: boolean;
}

const { id, eyebrow, title, showPeriod = true, showCaptionOnMobile = false } = Astro.props;
---

<div class="mb-7 tablet:mb-[38px] tablet:flex tablet:items-end tablet:justify-between tablet:gap-[30px]">
  <div>
    <span class="block font-mono text-[11px] leading-[1.5] tracking-[1.65px] text-muted uppercase">{eyebrow}</span>
    <h2 id={id} class="mt-3 font-serif text-[32px] leading-[1.2] font-normal tracking-[-1.4px] tablet:mt-[13px] tablet:text-[clamp(30px,3.5vw,41px)]">
      {title}{showPeriod && <span class="text-rust">.</span>}
    </h2>
  </div>
  <p class:list={['pb-0.5 text-xs leading-[1.8] text-muted', showCaptionOnMobile ? 'mt-4 tablet:mt-0' : 'hidden tablet:block']}><slot /></p>
</div>
