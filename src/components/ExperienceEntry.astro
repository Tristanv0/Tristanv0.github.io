---
import { timelineLayout, type TimelineEntry } from '../data/experience';
interface Props { entry: TimelineEntry; index: number }
const { entry, index } = Astro.props;
const dialogId = `experience-modal-${entry.id}`;
const titleId = `${dialogId}-title`;
const highlights = entry.highlights.map(text => text.split(/(\*\*.*?\*\*)/g));
const layout = timelineLayout(entry);
---

<li class:list={['timeline-row', { 'is-education': entry.kind !== 'work' }]} style={`--entry-offset:${layout.offset}%;--entry-width:${layout.width}%;--entry-delay:${index * 90}ms`} data-timeline-row data-entry-kind={entry.kind} data-start-month={entry.startMonth} data-end-month={entry.endMonth}>
  <button class="timeline-pill" type="button" aria-haspopup="dialog" aria-controls={dialogId} aria-expanded="false" data-experience-open>
    <span class="entry-label">
      <span class="entry-logo" aria-hidden="true">
        {entry.logo ? <img src={entry.logo} width="48" height="48" alt="" loading="lazy" decoding="async" /> : entry.kind === 'club' ?
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m11 9-7 7 7 7m10-14 7 7-7 7M19 5l-6 22" /></svg> :
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 12 13-6 13 6-13 6-13-6Zm5 3v8c5 4 11 4 16 0v-8M29 12v10" /></svg>}
      </span>
      <span class="entry-copy">
        <span class="entry-organization">{entry.shortOrganization}</span>
        <span class="entry-role">{entry.title}</span>
        <span class="entry-mobile-date">{entry.date}</span>
      </span>
    </span>
    <span class="entry-date" aria-hidden="true"><span>{entry.year}</span><span>{entry.months}</span></span>
    <span class="sr-only">{entry.date}. View {entry.kind === 'education' ? 'education' : 'experience'} details.</span>
  </button>

  <dialog id={dialogId} class="experience-dialog" aria-labelledby={titleId} data-experience-dialog>
    <article class="experience-panel" data-experience-panel>
      <div class="experience-modal-topline">
        <span>{entry.kind === 'education' ? 'Education' : entry.kind === 'club' ? 'Student club' : 'Work experience'}</span>
        <button type="button" class="experience-close" aria-label="Close details" autofocus data-experience-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <div class="experience-modal-heading">
        <span class="entry-logo modal-logo" aria-hidden="true">
          {entry.logo ? <img src={entry.logo} width="56" height="56" alt="" loading="lazy" decoding="async" /> : entry.kind === 'club' ?
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m11 9-7 7 7 7m10-14 7 7-7 7M19 5l-6 22" /></svg> :
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 12 13-6 13 6-13 6-13-6Zm5 3v8c5 4 11 4 16 0v-8M29 12v10" /></svg>}
        </span>
        <div><p class="experience-modal-organization">{entry.organization}</p><h3 id={titleId}>{entry.title}</h3></div>
      </div>
      <div class="experience-modal-meta"><span>{entry.date}</span><span>{entry.location}</span></div>
      <div class="experience-highlights">
        {entry.kind === 'work' && entry.inProgress ? <p class="experience-in-progress">{entry.highlights[0]}</p> : <>
        <p>{entry.kind === 'education' ? 'What I’m studying' : 'What I worked on'}</p>
        <ul>
          {highlights.map(parts => <li>{parts.map(part => part.startsWith('**') && part.endsWith('**') ? <strong>{part.slice(2, -2)}</strong> : part)}</li>)}
        </ul>
        </>}
      </div>
    </article>
  </dialog>
</li>

<style>
  .timeline-row { position: relative; min-width: 0; --entry-bg: #efd0b9; --entry-ink: #573a2d; --entry-accent: #a05430; }
  .timeline-row::before { content: ''; position: absolute; left: -19px; top: 50%; width: 7px; height: 7px; border-radius: 50%; background: var(--entry-accent); box-shadow: 0 0 0 4px var(--color-paper); }
  .is-education { --entry-bg: #d9e5ed; --entry-ink: #2e4e64; --entry-accent: #426d89; }
  .timeline-pill {
    position: relative; display: grid; grid-template-columns: minmax(0,1fr); align-items: center; gap: 12px;
    width: 100%; min-height: 84px; padding: 12px 18px; border: 1px solid transparent; border-radius: 28px;
    color: var(--entry-ink); background: var(--entry-bg); text-align: left;
    transition: background-color 220ms ease, box-shadow 220ms ease, translate 300ms cubic-bezier(.22,1,.36,1);
  }
  .timeline-pill:hover { translate: 0 -3px; box-shadow: 0 9px 24px -15px var(--entry-accent); }
  .timeline-pill:focus-visible { outline: 2px solid var(--entry-accent); outline-offset: 5px; }
  .entry-label { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .entry-logo { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 36px; height: 36px; overflow: hidden; border: 1px solid #ffffff66; border-radius: 11px; background: #ffffff70; }
  .entry-logo img { width: 100%; height: 100%; object-fit: contain; }
  .entry-logo svg { width: 28px; height: 28px; }
  .entry-copy { display: grid; gap: 4px; min-width: 0; }
  .entry-organization { font-size: 15px; font-weight: 600; line-height: 1.3; letter-spacing: -.35px; }
  .entry-role { font-size: 12px; line-height: 1.5; }
  .entry-mobile-date { margin-top: 3px; font-family: var(--font-mono); font-size: 9px; line-height: 1.6; opacity: .8; }
  .entry-date { display: none; }
  .timeline-row[data-entry-reveal='pending'] .timeline-pill { opacity: 0; transform: translateX(64px) rotate(3deg); }
  .timeline-row[data-entry-reveal='entering'] .timeline-pill { animation: entry-roll 800ms cubic-bezier(.22,1,.36,1) var(--entry-delay) both; }
  @keyframes entry-roll { from { opacity: 0; transform: translateX(64px) rotate(3deg); } to { opacity: 1; transform: none; } }
  .experience-dialog { position: fixed; inset: 0; margin: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; padding: 20px; border: 0; background: transparent; color: var(--color-ink); overflow: hidden; }
  .experience-dialog[open] { display: flex; align-items: center; justify-content: center; }
  .experience-dialog::backdrop { background: #292a2570; backdrop-filter: blur(6px); }
  .experience-panel { width: 100%; max-width: 680px; max-height: calc(100dvh - 40px); overflow-y: auto; overscroll-behavior: contain; padding: 24px; border: 1px solid var(--color-line); border-radius: 24px; background: var(--color-paper); box-shadow: 0 24px 100px #292a2533; }
  .experience-modal-topline { position: sticky; top: -24px; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 24px; background: var(--color-paper); color: var(--entry-accent); font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.3px; text-transform: uppercase; }
  .experience-close { display: grid; place-items: center; flex-shrink: 0; width: 36px; height: 36px; border: 1px solid var(--color-line); border-radius: 50%; background: var(--color-paper); color: var(--color-ink); transition: background-color 200ms ease; }
  .experience-close:hover { background: var(--entry-bg); }
  .experience-close svg { width: 18px; height: 18px; }
  .experience-modal-heading { display: flex; align-items: flex-start; gap: 16px; }
  .modal-logo { flex-shrink: 0; width: 48px; height: 48px; border-color: var(--color-line); background: white; }
  .experience-modal-organization { margin-bottom: 8px; color: var(--entry-accent); font-size: 12px; line-height: 1.6; }
  .experience-modal-heading h3 { font-family: var(--font-serif); font-size: 28px; font-weight: 400; line-height: 1.2; letter-spacing: -.7px; }
  .experience-modal-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-top: 24px; padding: 16px 0; border-block: 1px solid var(--color-line); color: var(--color-muted); font-family: var(--font-mono); font-size: 10px; line-height: 1.6; }
  .experience-highlights { margin-top: 24px; }
  .experience-highlights > p { margin-bottom: 16px; color: var(--entry-accent); font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; text-transform: uppercase; }
  .experience-highlights > .experience-in-progress { margin-bottom: 0; color: var(--color-muted); font-family: var(--font-sans); font-size: 14px; line-height: 1.8; letter-spacing: 0; text-transform: none; }
  .experience-highlights ul { display: grid; gap: 16px; padding-left: 17px; list-style: disc; color: var(--color-muted); font-size: 13px; line-height: 1.85; }
  .experience-highlights li::marker { color: var(--entry-accent); }
  .experience-highlights strong { font-weight: 600; color: var(--color-ink); }
  @media (width >= 701px) {
    .timeline-pill { grid-template-columns: minmax(0,1fr) auto; gap: 18px; padding: 14px 24px; border-radius: 999px; }
    .entry-label { gap: 18px; }
    .entry-logo { width: 44px; height: 44px; border-radius: 12px; }
    .entry-organization { font-size: 18px; }
    .entry-role { font-size: 13px; }
    .entry-mobile-date { display: none; }
    .entry-date { display: grid; gap: 3px; margin-left: 8px; text-align: right; }
    .entry-date > span:first-child { font-size: 25px; font-weight: 500; letter-spacing: -1px; line-height: 1.2; }
    .entry-date > span:last-child { font-family: var(--font-mono); font-size: 9px; opacity: .8; }
    .experience-panel { padding: 32px; }
    .experience-modal-topline { top: -32px; }
    .experience-modal-heading { gap: 20px; }
    .modal-logo { width: 56px; height: 56px; }
    .experience-modal-heading h3 { font-size: 34px; }
    .experience-highlights ul { font-size: 14px; }
  }
  @media (width >= 1001px) {
    .timeline-pill { margin-left: var(--entry-offset); width: var(--entry-width); gap: 12px; padding-inline: 22px; }
    .entry-label { gap: 12px; }
    .entry-organization { font-size: 16px; }
    .entry-role { font-size: 12px; }
    .entry-date { margin-left: 0; }
    .entry-date > span:first-child { font-size: 22px; }
    .timeline-row::before { display: none; }
  }
  @media (1001px <= width < 1201px) {
    .timeline-row:not(.is-education) .timeline-pill { grid-template-columns: minmax(0,1fr); padding-inline: 18px; }
    .timeline-row:not(.is-education) .entry-logo { width: 36px; height: 36px; }
    .timeline-row:not(.is-education) .entry-mobile-date { display: block; }
    .timeline-row:not(.is-education) .entry-date { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-row[data-entry-reveal] .timeline-pill { opacity: 1; transform: none; animation: none; }
    .timeline-pill:hover { translate: none; }
  }
</style>
