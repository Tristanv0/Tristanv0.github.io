---
import RunCard from './RunCard.astro';
import RunModal from './RunModal.astro';
import ScrollArrows from './ScrollArrows.astro';
import GymBackground from './GymBackground.astro';
import GymCalendar from './GymCalendar.astro';
import WorkoutCard from './WorkoutCard.astro';
import WorkoutModal from './WorkoutModal.astro';
import HobbyTab from './HobbyTab.astro';
import { getRecentRuns } from '../data/runs';
import { getRecentWorkouts } from '../data/workouts';

const apiOrigin = import.meta.env.STREVY_API_ORIGIN || 'http://localhost:3001';
const [{ runs, available }, workoutSnapshot] = await Promise.all([
  getRecentRuns(apiOrigin), getRecentWorkouts(apiOrigin),
]);

// A consistent scattered arrangement, with complete classes for Tailwind.
const runLayouts = [
  { width: 'w-[240px] tablet:w-[260px]', offset: 'pt-[calc(var(--run-stagger)*0.45)]', gap: 'mr-8 tablet:mr-[76px] desktop:mr-[96px]' },
  { width: 'w-[200px] tablet:w-[210px]', offset: 'pt-0', gap: 'mr-12 tablet:mr-[96px] desktop:mr-[124px]' },
  { width: 'w-[250px] tablet:w-[285px]', offset: 'pt-[calc(var(--run-stagger)*0.85)]', gap: 'mr-10 tablet:mr-[70px] desktop:mr-[90px]' },
  { width: 'w-[215px] tablet:w-[235px]', offset: 'pt-[calc(var(--run-stagger)*0.18)]', gap: 'mr-14 tablet:mr-[110px] desktop:mr-[132px]' },
  { width: 'w-[225px] tablet:w-[250px]', offset: 'pt-[var(--run-stagger)]', gap: '' },
];
const hobbies = [{ id: 'running', label: 'Running' }, { id: 'gym', label: 'The gym' }];
// Attendance can use the full history while the carousel keeps five sessions.
const recentWorkouts = workoutSnapshot.workouts;
const scrollerClass = 'flex h-full min-w-0 snap-x snap-mandatory items-start overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden scroll-px-[var(--run-edge)] pt-5 pb-10 [--run-stagger-max:96px] [--run-stagger:var(--run-stagger-max)] data-[pinned=true]:snap-none tablet:pt-6 tablet:pb-14 tablet:[--run-stagger-max:170px] desktop:[--run-stagger-max:210px]';
---

<section
  class="relative isolate scroll-mt-[30px] overflow-clip bg-hobby-paper pt-[67px] pb-5 [--hobby-color:#FC4C02] tablet:pt-[103px] tablet:pb-8"
  id="hobbies"
  aria-labelledby="hobbies-title"
  data-hobbies
>
  <ScrollArrows />
  <GymBackground />
  <div class="relative mx-auto w-[calc(100%-44px)] max-w-[1100px] tablet:w-[calc(100%-72px)] desktop:w-[calc(100%-112px)]">
    <div class="flex items-start justify-between gap-5 tablet:items-center tablet:gap-[70px]">
      <div class="relative bg-hobby-paper shadow-[0_0_35px_22px_var(--color-hobby-paper)]">
        <span class="block font-mono text-[11px] leading-[1.5] tracking-[1.65px] text-muted uppercase">Life outside the editor</span>
        <h2 id="hobbies-title" class="mt-6 mb-[25px] font-serif text-[clamp(54px,11vw,76px)] leading-[0.99] font-normal tracking-[-2.8px] tablet:text-[clamp(60px,7vw,94px)] tablet:tracking-[-4px]">
          Away from<br>the <em class="font-normal text-[var(--hobby-color)] transition-colors duration-200 ease-out">keyboard.</em>
        </h2>
        <p class="max-w-[280px] text-[12px] leading-[1.9] text-[#747064] tablet:max-w-none tablet:text-[14px]">
          A little movement between projects.<br>A few miles, a few reps, and a different kind of progress.
        </p>
      </div>
      <span class="absolute top-[245px] right-[5px] -rotate-12 bg-hobby-paper text-center font-serif text-[16px] leading-[1.1] text-rust italic shadow-[0_0_20px_12px_var(--color-hobby-paper)] phone:text-[19px] tablet:static tablet:mr-[5%] tablet:text-[29px] desktop:mr-[11%]" aria-hidden="true" data-hobby-decoration="running">
        taking the<br>scenic route
      </span>
    </div>

    <div class="relative left-[calc(50%-var(--run-viewport-width,100vw)/2)] mt-[60px] w-[var(--run-viewport-width,100vw)] [--run-edge:22px] tablet:mt-20 tablet:[--run-edge:36px] desktop:[--run-edge:56px]" data-run-scroll-track>
      <div class="relative data-[pinned=true]:sticky data-[pinned=true]:top-[var(--run-pin-top)]" data-run-sticky>
        <span class="gym-note pointer-events-none invisible absolute top-[calc(var(--run-leading-height,0px)+48px)] right-[var(--run-edge)] z-[-1] -rotate-[7deg] text-center text-[16px] leading-[1.15] text-[#4773ad] tablet:top-1 tablet:right-auto tablet:left-[40%] tablet:text-[23px] desktop:left-[46%]" data-hobby-decoration="gym" data-gym-note aria-hidden="true">
          one more rep
          <svg class="mx-auto mt-1 h-3 w-[110px] fill-none stroke-current opacity-45 tablet:w-[145px]" viewBox="0 0 145 12" stroke-width="1" stroke-linecap="round" focusable="false"><path d="M 4 7 Q 49 0 139 4 M 49 10 Q 89 6 119 7" /></svg>
        </span>
        <GymCalendar workouts={workoutSnapshot.calendarEntries} />
        <div class="flex items-center gap-2 px-[var(--run-edge)] pb-4" role="tablist" aria-label="Choose a hobby" data-hobby-tabs>
          {hobbies.map(hobby => <HobbyTab id={hobby.id} label={hobby.label} />)}
        </div>
        <div class="grid" data-hobby-panels>
          {hobbies.map(hobby => (
            <div class:list={['min-w-0 [grid-area:1/1]', { invisible: hobby.id !== 'running' }]} id={`hobby-panel-${hobby.id}`} role="tabpanel" aria-labelledby={`hobby-tab-${hobby.id}`} aria-hidden={hobby.id !== 'running' ? 'true' : 'false'} inert={hobby.id !== 'running'} data-hobby-panel={hobby.id}>
              <div class={scrollerClass} tabindex="0" role="region" aria-label={hobby.id === 'running' ? 'Latest runs' : 'Latest gym workouts'} data-run-scroller>
                <div class="h-px w-[var(--run-edge)] shrink-0" aria-hidden="true" data-run-edge="start"></div>
                {hobby.id === 'running' ? runs.map((run, index) => {
                  const layout = runLayouts[index % runLayouts.length];
                  return <div class:list={['min-w-0 shrink-0 snap-start', layout.width, layout.offset, index < runs.length - 1 ? layout.gap : '']} data-run-slot><RunCard run={run} index={index} /></div>;
                }) : recentWorkouts.map((workout, index) => {
                  const layout = runLayouts[index % runLayouts.length];
                  return <div class:list={['min-w-0 shrink-0 snap-start', layout.width, layout.offset, index < recentWorkouts.length - 1 ? layout.gap : '']} data-run-slot><WorkoutCard workout={workout} index={index} /></div>;
                })}
                {hobby.id === 'running' && runs.length === 0 && (
                  <p class="w-[calc(100%-2*var(--run-edge))] shrink-0 rounded-[3px] border border-line bg-run-paper px-6 py-10 text-center text-[14px] leading-[1.8] text-muted" role="status">
                    {available ? 'No runs to show yet.' : 'Recent runs are unavailable right now. Please check back soon.'}
                  </p>
                )}
                {hobby.id === 'gym' && recentWorkouts.length === 0 && (
                  <p class="w-[calc(100%-2*var(--run-edge))] shrink-0 rounded-[3px] border border-line bg-run-paper px-6 py-10 text-center text-[14px] leading-[1.8] text-muted" role="status">
                    {workoutSnapshot.available ? 'No workouts to show yet.' : 'Recent workouts are unavailable right now. Please check back soon.'}
                  </p>
                )}
                <div class="h-px w-[var(--run-edge)] shrink-0" aria-hidden="true" data-run-edge="end"></div>
              </div>
            </div>
          ))}
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-hobby-status></p>
      </div>
    </div>

  </div>
</section>

{runs.map(run => <RunModal run={run} />)}
{recentWorkouts.map(workout => <WorkoutModal workout={workout} />)}

<style>
  .gym-note {
    font-family: "Bradley Hand", "Segoe Print", "Comic Sans MS", cursive;
    font-style: italic;
    opacity: 1;
    visibility: visible;
    transition: opacity 450ms ease, visibility 450ms;
  }
  .gym-note.invisible { opacity: 0; visibility: hidden; }
</style>

<script>
  import { initRunCarousel } from '../scripts/run-carousel';
  import { initHobbyTabs } from '../scripts/hobby-tabs';
  import { initActivityModals } from '../scripts/run-modal';
  initRunCarousel();
  initHobbyTabs();
  initActivityModals();
</script>
