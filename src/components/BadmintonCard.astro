---
import type { BadmintonDay } from '../data/badminton';
import BadmintonShuttle from './BadmintonShuttle.astro';
import Odometer from './Odometer.astro';
interface Props { day: BadmintonDay; index: number }
const { day, index } = Astro.props;
const tilts = ['-rotate-2', 'rotate-3', '-rotate-[1.5deg]', 'rotate-2', '-rotate-3'];
---

<button class:list={['group relative block w-full min-w-0 rounded-[3px] border border-[#cde0d2] bg-run-paper p-2 text-left text-ink shadow-[0_5px_14px_#342c1d07] transition duration-[220ms] hover:-translate-y-[7px] hover:rotate-0 hover:shadow-[0_10px_28px_#342c1d0c] focus-visible:outline-[#05A74F] desktop:p-2.5', tilts[index % tilts.length]]} type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls={`badminton-modal-${day.date}`} aria-label={`View badminton details for ${day.dateLabel}`} data-hobby-card data-activity-card data-activity-modal={`badminton-modal-${day.date}`}>
  <div class="bg-[#e4efe5] p-2.5">
    <div class="aspect-[4/3] text-[#05A74F]"><BadmintonShuttle /></div>
  </div>
  <div class="px-2 pt-4 pb-3">
    <time class="font-mono text-[9px] text-[#4c7059]" datetime={day.date}>{day.dateLabel}</time>
    <h4 class="mt-2 mb-4 font-serif text-[23px] leading-[1.25] tracking-[-0.5px]">Badminton</h4>
    <dl class="flex justify-between gap-2 tabular-nums">
      <div><dt class="font-mono text-[8px] text-muted">Duration</dt><dd class="mt-1.5 text-[13px]"><Odometer value={day.duration} /></dd></div>
      <div><dt class="font-mono text-[8px] text-muted">Active kcal</dt><dd class="mt-1.5 text-[13px]"><Odometer value={day.calories} /></dd></div>
      <div><dt class="font-mono text-[8px] text-muted">Rallies</dt><dd class="mt-1.5 text-[13px]"><Odometer value={day.rallies} /></dd></div>
    </dl>
  </div>
</button>
