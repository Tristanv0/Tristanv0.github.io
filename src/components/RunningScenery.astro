---
// Positions share the arrows' 1440 × 1200 drawing space. Rock clearances also
// allow for the arrows' full vertical drift, rather than just their rest pose.
const rocks = [
  { x: 385, y: 350, size: 0.8, rotation: -18 },
  { x: 790, y: 455, size: 1.4, rotation: -10, followArrow: 2 },
  { x: 585, y: 690, size: 0.65, rotation: 32 },
  { x: 1170, y: 715, size: 0.9, rotation: -12 },
  { x: 500, y: 995, size: 0.7, rotation: 68 },
];
const trees = [
  { x: 946, y: 340, size: 0.95, rotation: 12 },
  { x: 280, y: 550, size: 0.85, rotation: 78 },
  { x: 1295, y: 555, size: 1.1, rotation: -25 },
  { x: 690, y: 885, size: 0.8, rotation: 145 },
  { x: 1010, y: 1015, size: 1, rotation: 38 },
];
---

<defs>
  <!-- Paper halos soften an arrow before it disappears beneath a canopy. -->
  <radialGradient id="running-canopy-halo">
    <stop offset="50%" stop-color="var(--color-hobby-paper)" />
    <stop offset="72%" stop-color="var(--color-hobby-paper)" stop-opacity="0.92" />
    <stop offset="100%" stop-color="var(--color-hobby-paper)" stop-opacity="0" />
  </radialGradient>
  <radialGradient id="running-tree-shadow">
    <stop offset="30%" stop-color="#46543b" stop-opacity="0.12" />
    <stop offset="100%" stop-color="#46543b" stop-opacity="0" />
  </radialGradient>
  <g id="running-overhead-tree">
    <ellipse rx="102" ry="94" fill="url(#running-canopy-halo)" />
    <ellipse cx="9" cy="11" rx="73" ry="64" fill="url(#running-tree-shadow)" />
    <path d="M -14 -58 C -2 -72 20 -65 28 -53 C 47 -58 62 -44 59 -27 C 76 -16 73 6 61 16 C 68 35 51 52 34 49 C 25 68 3 69 -9 56 C -27 66 -49 53 -47 35 C -67 31 -73 9 -61 -5 C -72 -23 -56 -44 -39 -42 C -37 -58 -25 -65 -14 -58 Z" fill="#a9b68e" />
    <path d="M -42 -37 C -28 -45 -16 -37 -13 -25 C -2 -34 13 -25 12 -12 C 28 -15 36 1 29 13 C 44 22 39 43 23 47 C 8 63 -9 53 -12 41 C -31 52 -50 39 -45 23 C -61 13 -58 -8 -44 -12 C -53 -21 -51 -31 -42 -37 Z" fill="#95a67c" opacity="0.65" />
    <path d="M -18 -49 C -7 -61 10 -55 14 -43 C 29 -51 45 -38 38 -24 C 51 -15 44 2 29 2 C 23 16 4 14 -2 3 C -18 11 -34 -2 -27 -16 C -42 -29 -34 -46 -18 -49 Z" fill="#c0cba7" opacity="0.85" />
    <path d="M 19 11 C 31 1 48 10 44 23 C 52 36 36 48 25 41 C 14 52 -3 43 1 30 C -7 18 7 6 19 11 Z" fill="#b0bf97" />
    <g fill="none" stroke="#6b8056" stroke-width="1.2" stroke-linecap="round" opacity="0.25">
      <path d="M 0 15 L 6 -7 M 1 11 L -16 -2 M 4 2 L 20 -15 M -7 5 L -20 20 M 0 15 L 13 31" />
      <path d="M -32 -28 Q -21 -35 -15 -25 M 21 -37 Q 30 -35 29 -27 M -31 29 Q -23 35 -16 31" />
    </g>
  </g>
  <g id="running-overhead-rock">
    <ellipse cx="4" cy="8" rx="38" ry="25" fill="#756f60" opacity="0.08" />
    <path d="M -32 -7 Q -35 -14 -27 -20 L -9 -29 Q -4 -32 4 -29 L 27 -19 Q 33 -16 32 -8 L 28 13 Q 27 19 20 22 L -4 28 Q -11 29 -17 23 L -31 9 Z" fill="#d6d3c7" stroke="#b8b7a9" stroke-width="1" />
    <path d="M -27 -20 L -7 -13 L 6 5 L 27 -19 L 4 -29 Q -4 -32 -9 -29 Z" fill="#e6e3d8" />
    <path d="M 6 5 L 28 13 Q 27 19 20 22 L -4 28 L -3 10 Z" fill="#c4c4b8" />
    <path d="M -27 -20 L -7 -13 L 6 5 L 27 -19 M 6 5 L -3 10 L -4 28" fill="none" stroke="#b6b7a8" stroke-width="0.9" opacity="0.6" />
    <path d="M 38 20 L 43 17 L 50 22 L 47 29 L 40 28 Z" fill="#d1d0c3" />
    <path d="M -30 31 L -23 29 L -19 35 L -26 39 L -32 36 Z" fill="#dedbd0" />
  </g>
</defs>

<g stroke="none" data-running-scenery>
  {rocks.map(rock => (
    <g data-scenery-arrow={rock.followArrow}>
      <g transform={`translate(${rock.x} ${rock.y}) rotate(${rock.rotation}) scale(${rock.size})`} data-running-rock>
        <use href="#running-overhead-rock" />
      </g>
    </g>
  ))}
  {trees.map(tree => (
    <g transform={`translate(${tree.x} ${tree.y}) rotate(${tree.rotation}) scale(${tree.size})`} data-running-tree>
      <use href="#running-overhead-tree" />
    </g>
  ))}
</g>
